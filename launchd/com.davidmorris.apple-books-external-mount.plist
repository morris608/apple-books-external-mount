<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.davidmorris.apple-books-external-mount</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Launcher binary (not zsh directly) so the job has its own TCC
         identity — grant it Full Disk Access in System Settings. -->
    <string>/Users/davidmorris/GitHub/apple-books-external-mount/bin/abe-launcher</string>
    <string>ensure</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>StartOnMount</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/davidmorris/Library/Logs/apple-books-external-mount/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/davidmorris/Library/Logs/apple-books-external-mount/launchd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
