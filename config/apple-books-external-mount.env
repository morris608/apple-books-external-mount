#!/bin/zsh
# Config for apple-books-external-mount
export ABE_EXTERNAL_UUID="EB22CF2C-723B-4305-942D-8476A3EB5035"
export ABE_EXTERNAL_NAME="25External"
export ABE_IMAGE="/Volumes/25External/BooksSafety/phase0b-populated.sparsebundle"
export ABE_VOLUME_NAME="Phase0bPop"
export ABE_AUDIOBOOKS_PATH="${HOME}/Library/Containers/com.apple.BKAgentService/Data/Documents/ibooks/Books/Audiobooks"
export ABE_ASIDE_PATH="${HOME}/Library/Containers/com.apple.BKAgentService/Data/Documents/ibooks/Books/Audiobooks.internal-aside"
export ABE_LOCK="/tmp/apple-books-external-mount.lock"
export ABE_INHIBIT="/tmp/apple-books-external-mount.inhibit-mount"
export ABE_EJECT_STATUS="/tmp/apple-books-external-mount.eject-status"
export ABE_LOG_DIR="${HOME}/Library/Logs/apple-books-external-mount"
