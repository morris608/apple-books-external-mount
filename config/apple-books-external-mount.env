#!/bin/zsh
# Config for apple-books-external-mount
export ABE_EXTERNAL_UUID="EB22CF2C-723B-4305-942D-8476A3EB5035"
export ABE_EXTERNAL_NAME="25External"
export ABE_IMAGE="/Volumes/25External/BooksSafety/phase0b-populated.sparsebundle"
export ABE_VOLUME_NAME="Phase0bPop"
export ABE_AUDIOBOOKS_PATH="${HOME}/Library/Containers/com.apple.BKAgentService/Data/Documents/ibooks/Books/Audiobooks"
export ABE_ASIDE_PATH="${HOME}/Library/Containers/com.apple.BKAgentService/Data/Documents/ibooks/Books/Audiobooks.internal-aside"
export ABE_LOCK="/tmp/apple-books-external-mount.lock"
export ABE_INHIBIT="/tmp/apple-books-external-mount.inhibit-mount"
export ABE_EJECT_STATUS="/tmp/apple-books-external-mount.eject-status"
export ABE_LOG_DIR="${HOME}/Library/Logs/apple-books-external-mount"

# Books catalogs — pruned by Books whenever it runs without the media mounted
# (2026-08-07, 2026-09-09). Backed up to the external on mount/unmount.
export ABE_BKLIBRARY_DIR="${HOME}/Library/Containers/com.apple.iBooksX/Data/Documents/BKLibrary"
export ABE_BKSERIES_DIR="${HOME}/Library/Containers/com.apple.iBooksX/Data/Documents/BKSeriesDatabase"
export ABE_BOOKS_PLIST="${HOME}/Library/Containers/com.apple.BKAgentService/Data/Documents/ibooks/Books/Books.plist"
export ABE_CATALOG_BACKUP_DIR="/Volumes/25External/BooksSafety/catalog"
export ABE_CATALOG_FALLBACK="/Volumes/25External/BooksSafety/2026-07-26T235612/metadata-snapshot"
# Books.plist has 2 "path" entries per audiobook (688 books ≈ 1376); fewer than
# this means the catalog has been pruned.
export ABE_CATALOG_MIN_PATHS=1000
export ABE_CATALOG_KEEP=10
# Quit Books if it is running while the media is not mounted (1=on).
export ABE_GUARD_BOOKS=1
