#!/bin/zsh
# Shared config for BooksMedia mount automation
export BOOKS_MEDIA_EXTERNAL_UUID="EB22CF2C-723B-4305-942D-8476A3EB5035"
export BOOKS_MEDIA_EXTERNAL_NAME="25External"
export BOOKS_MEDIA_IMAGE="/Volumes/25External/BooksSafety/phase0b-populated.sparsebundle"
export BOOKS_MEDIA_VOLUME_NAME="Phase0bPop"
export BOOKS_AUDIOBOOKS_PATH="${HOME}/Library/Containers/com.apple.BKAgentService/Data/Documents/ibooks/Books/Audiobooks"
export BOOKS_ASIDE_PATH="${HOME}/Library/Containers/com.apple.BKAgentService/Data/Documents/ibooks/Books/Audiobooks.internal-aside"
export BOOKS_MEDIA_LOCK="/tmp/books-media.lock"
export BOOKS_MEDIA_INHIBIT="/tmp/books-media.inhibit-mount"
export BOOKS_MEDIA_EJECT_STATUS="/tmp/books-media.eject-status"
export BOOKS_MEDIA_LOG_DIR="${HOME}/Library/Logs/books-media"
